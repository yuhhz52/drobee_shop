# ==============================================================
# LOCAL DEVELOPMENT ENVIRONMENT
# ==============================================================
# Copy this file to .env and fill in your values.
# DO NOT commit this file to git.
#
# For production values, see .env.production
# ==============================================================

# =======================
# DATABASE
# =======================
DB_URL=jdbc:postgresql://localhost:5432/scooter
DB_USERNAME=postgres
DB_PASSWORD=your_local_password

# =======================
# REDIS
# =======================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# =======================
# MAIL (use App Password, NOT your real password)
# =======================
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=xxxx xxxx xxxx xxxx

# =======================
# GOOGLE OAUTH2
# =======================
# Create OAuth2 client at: https://console.cloud.google.com
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret

# =======================
# JWT
# =======================
JWT_SECRET=generate_a_random_64_char_hex_string_here

# =======================
# APP URL (used by OAuth2 to build redirect URIs)
# =======================
# Local: keep http://localhost:8080
# Production Railway: https://scooter-production.up.railway.app
APP_URL=http://localhost:8080

# =======================
# CORS
# =======================
APP_CORS_ORIGIN_1=http://localhost:5173
APP_CORS_ORIGIN_2=http://localhost:5175
APP_CORS_ORIGIN_3=http://localhost:3000

# =======================
# OAUTH2 REDIRECT (frontend callback after login)
# =======================
# Local: points to your Vite dev server
APP_OAUTH2_REDIRECT_URI=http://localhost:5175/oauth2/callback
ORDER_CONFIRMED_URL=http://localhost:5175/order-confirmed

# =======================
# STRIPE (use test keys for local dev)
# =======================
STRIPE_SECRET=sk_test_your_stripe_secret_key

# =======================
# VNPAY
# =======================
VNPAY_TMN_CODE=your_tmn_code
VNPAY_HASH_SECRET=your_hash_secret
VNPAY_RETURN_URL=http://localhost:5175/payment/vnpay/return

# =======================
# UPLOAD
# =======================
UPLOAD_DIR=uploads
